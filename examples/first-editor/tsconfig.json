{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "jsx": "react-jsx",

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    "strict": true,

    "paths": {
      "@tasfer/editor": ["../../packages/editor/src/index.ts"],
      "@tasfer/editor/*": ["../../packages/editor/src/*"],
      "@tasfer/tex": ["../../packages/tex/src/index.ts"],
      "@tasfer/tex/*": ["../../packages/tex/src/*"],
      "@tasfer/react": ["../../packages/react/src/index.ts"],
      "@tasfer/react/*": ["../../packages/react/src/*"],
      "@tasfer/provider-core": ["../../packages/provider-core/src/index.ts"],
      "@tasfer/provider-core/*": ["../../packages/provider-core/src/*"],
      "@tasfer/provider-relay": ["../../packages/provider-relay/src/index.ts"],
      "@shared/*": ["../../shared/*"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"]
    }
  },
  "include": ["src"]
}
