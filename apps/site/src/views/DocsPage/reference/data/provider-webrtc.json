   "id": "@tasfer/provider-webrtc",
   "symbols": [
    {
     "name": "createWebrtcProvider",
     "kind": "function",
     "sigs": [
      "function createWebrtcProvider(\n  options: CreateWebrtcProviderOptions,\n): Provider"
     ],
     "summary": "Sync a document with everyone in the same room over direct WebRTC connections.",
     "doc": [
      {
       "type": "paragraph",
       "children": [
        {
         "type": "text",
         "value": "Sync a document with everyone in the same room over direct WebRTC\nconnections. The signaling server only introduces peers to each other. It\nsees a hash of the room name, and the document does not pass through it.\nAnyone who knows the room name can join, so use one that is hard to guess.\nTwo peers whose direct connection fails do not sync with each other."
        }
       ]
      },
      {
       "type": "code",
       "value": "const provider = createWebrtcProvider({\n  doc: editor.doc,\n  room: \"team-notes-7f3k2q\",\n  signaling: \"wss://signal.example.com\",\n});\nprovider.on(\"sync\", (s) => console.log(s.connected, s.peers));",
       "lang": "ts"
      }
     ],
     "src": "packages/provider-webrtc/src/provider.ts",
     "from": [
      "@tasfer/provider-webrtc"
     ]
    },
    {
     "name": "WebrtcTransport",
     "kind": "class",
     "sigs": [
      "class WebrtcTransport implements Transport"
     ],
     "summary": "The connection behind `createWebrtcProvider`: it finds peers through a signaling server, then connects each pair directly over WebRTC so document data does not pass through the server.",
     "doc": [
      {
       "type": "paragraph",
       "children": [
        {
         "type": "text",
         "value": "The connection behind "
        },
        {
         "type": "link",
         "url": "ref:createWebrtcProvider",
         "children": [
          {
           "type": "inlineCode",
           "value": "createWebrtcProvider"
          }
         ]
        },
        {
         "type": "text",
         "value": ": it finds peers through\na signaling server, then connects each pair directly over WebRTC so\ndocument data does not pass through the server. Use it directly only when\nyou want to pass it to "
        },
        {
         "type": "inlineCode",
         "value": "createProvider"
        },
        {
         "type": "text",
         "value": " from "
        },
        {
         "type": "inlineCode",
         "value": "@tasfer/provider-core"
        },
        {
         "type": "text",
         "value": "\nyourself."
        }
       ]
      }
     ],
