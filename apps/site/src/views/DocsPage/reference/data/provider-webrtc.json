       "name": "topic",
       "kind": "property",
       "sig": "topic: string | Promise<string>",
       "summary": "The id the signaling server uses to group peers: 64 hex characters.",
       "doc": [
        {
         "type": "paragraph",
         "children": [
          {
           "type": "text",
           "value": "The id the signaling server uses to group peers: 64 hex characters. The\nserver sees it as is, so make it from something secret, for example a\nSHA-256 hash of the room name, as "
          },
          {
           "type": "link",
           "url": "ref:createWebrtcProvider",
           "children": [
            {
             "type": "inlineCode",
             "value": "createWebrtcProvider"
            }
           ]
          },
          {
           "type": "text",
           "value": " does. You\ncan pass a promise of it. "
          },
          {
           "type": "inlineCode",
           "value": "connect()"
          },
          {
           "type": "text",
           "value": " rejects when it is not 64 hex\ncharacters (upper or lower case both work)."
          }
         ]
        }
       ]
      },
      {
       "name": "signaling",
       "kind": "property",
       "sig": "signaling: string",
