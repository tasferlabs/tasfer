        {
         "type": "paragraph",
         "children": [
          {
           "type": "text",
           "value": "Relay base URL, e.g. \"wss://relay.tasfer.app\"."
          }
         ]
        }
       ]
      },
      {
       "name": "peerId",
       "kind": "property",
       "sig": "peerId?: string",
       "summary": "This replica's stable id.",
       "doc": [
        {
         "type": "paragraph",
         "children": [
          {
           "type": "text",
           "value": "This replica's stable id. Defaults to "
          },
          {
           "type": "inlineCode",
           "value": "doc.peerId"
          },
          {
           "type": "text",
           "value": "."
          }
         ]
        }
       ]
      },
      {
       "name": "secret",
       "kind": "property",
       "sig": "secret: string | Uint8Array | null",
       "summary": "The room's shared secret: a passphrase or raw key bytes.",
       "doc": [
        {
         "type": "paragraph",
         "children": [
          {
           "type": "text",
           "value": "The room's shared secret: a passphrase or raw key bytes. Share it with the\nother peers yourself, for example in an invite link. Document data is\nencrypted with AES-256-GCM using a key made from it, so the relay cannot\nread it."
          }
         ]
        },
        {
         "type": "paragraph",
         "children": [
          {
           "type": "inlineCode",
           "value": "null"
          },
          {
           "type": "text",
           "value": " turns encryption off. Whoever runs the relay can then read and\nchange every document in the room. Only do this when you run the relay\nyourself, or you already encrypt the data before this provider."
          }
         ]
        }
       ]
      }
     ],
