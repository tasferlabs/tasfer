{
  "name": "@tasfer/cli",
  "version": "0.1.6",
  "license": "AGPL-3.0-or-later",
  "description": "Headless Tasfer host — a replica of your spaces that stays online on your own machine",
  "homepage": "https://github.com/tasferlabs/tasfer",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "tasfer": "./dist/main.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "start": "node dist/main.mjs",
    "build:binary": "node scripts/build-binary.mjs"
  },
  "dependencies": {
    "@noble/curves": "^2.2.0",
    "better-sqlite3": "^12.11.1",
    "jszip": "^3.10.1",
    "lowlight": "^3.3.0",
    "nanoid": "^5.1.7",
    "turndown": "^7.2.4",
    "ws": "^8.21.3"
  },
  "optionalDependencies": {
    "node-datachannel": "^0.33.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/hast": "^3.0.4",
    "@types/node": "^26.2.0",
    "@types/turndown": "^5.0.5",
    "@types/ws": "^8.18.1",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2"
  }
}
