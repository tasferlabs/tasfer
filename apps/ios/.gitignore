App/build
App/Pods
App/output
App/App/public
DerivedData
xcuserdata

# Local signing config (holds each developer's own DEVELOPMENT_TEAM)
DeveloperSettings.xcconfig

# Cordova plugins for Capacitor
capacitor-cordova-ios-plugins

# Generated Config files
App/App/capacitor.config.json
App/App/config.xml

# String Catalog generated from the web locales by
# apps/web/scripts/gen-ios-strings.mjs on every native build, then rewritten
# again by Xcode (its own JSON spacing, plus a CFBundleName entry extracted
# from Info.plist). Tracking it only recorded that tug-of-war.
App/App/InfoPlist.xcstrings

# App version (MARKETING_VERSION / CURRENT_PROJECT_VERSION), generated from
# /version.json by scripts/release/gen-ios-version.mjs on install and on every
# native build. The Xcode project stores no version of its own.
Version.xcconfig
