VITE_STAGING=true
VITE_SIGNAL_URL=wss://your-domain.com/ws

# A path instead of a URL routes signaling through the dev server's proxy to a
# local `wrangler dev` (apps/live) — the only form that works with `dev:host`
# and native live reload, where the page is HTTPS on a LAN address. Override the
# proxy target (default http://127.0.0.1:8787) with VITE_SIGNAL_PROXY.
# VITE_SIGNAL_URL=/__signal

# Capacitor: point the native WebView at a live dev server for live reload.
# Leave unset to load the bundled static export (dist) from `cap sync`.
# Must be HTTPS (see `npm run dev:host`).
# CAP_SERVER_URL=https://192.168.xx.yy:4000
