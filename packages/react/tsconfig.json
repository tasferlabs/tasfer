{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "jsx": "react-jsx",
    // Resolve the sibling engine from its built dist declarations, so build in
    // dependency order: editor before this. React's own types come from the
    // locally-installed @types/react(-dom) devDependencies.
    "paths": {
      "*": ["./*"],
      "@tasfer/editor": ["../editor/dist/index.d.mts"],
      "@tasfer/editor/*": ["../editor/dist/*"]
    }
  },
  "include": ["src"]
}
