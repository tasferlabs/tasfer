{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "separate-pull-requests": false,
  "packages": {
    "packages/tex": {
      "release-type": "node",
      "component": "tex"
    },
    "packages/editor": {
      "release-type": "node",
      "component": "editor"
    },
    "packages/math": {
      "release-type": "node",
      "component": "math"
    },
    "packages/code": {
      "release-type": "node",
      "component": "code"
    },
    "packages/provider-core": {
      "release-type": "node",
      "component": "provider-core"
    },
    "packages/provider-indexeddb": {
      "release-type": "node",
      "component": "provider-indexeddb"
    },
    "packages/provider-relay": {
      "release-type": "node",
      "component": "provider-relay"
    },
    "packages/provider-webrtc": {
      "release-type": "node",
      "component": "provider-webrtc"
    },
    "packages/react": {
      "release-type": "node",
      "component": "react"
    },
    "apps/desktop": {
      "component": "desktop",
      "include-component-in-tag": false,
      "extra-files": [
        {
          "type": "json",
          "path": "/version.json",
          "jsonpath": "$.appVersion"
        }
      ]
    }
  },
  "plugins": [
    {
      "type": "linked-versions",
      "groupName": "tasfer packages",
      "components": [
        "tex",
        "editor",
        "math",
        "code",
        "provider-core",
        "provider-indexeddb",
        "provider-relay",
        "provider-webrtc",
        "react"
      ]
    }
  ]
}
